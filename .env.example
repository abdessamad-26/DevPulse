# Environment template for local development
# Copy this file to .env and fill the required values for your environment.

# Application
APP_ENV=development
DEMO_MODE=true

# Backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devpulse
DB_USERNAME=devpulse
DB_PASSWORD=change_me
JWT_SECRET=change_me_in_local_env
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=604800

# Frontend
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080

# AI Service
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
AI_SERVICE_LLM_API_KEY=

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# Container runtime
COMPOSE_PROJECT_NAME=devpulse
