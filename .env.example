# Environment template for local development
# Copy this file to .env and fill the required values for your environment.
# (scripts/dev.ps1 and scripts/dev.sh do this for you and generate JWT_SECRET.)
# NEVER commit the real .env file.

# Application
APP_ENV=development
# Demo mode creates a known account (demo@devpulse.local / DemoPass123!).
# Keep it false everywhere except on your own machine.
DEMO_MODE=false
CHAOS_ALLOW_PRODUCTION=false

# Backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devpulse
DB_USERNAME=devpulse
DB_PASSWORD=change_me
# REQUIRED: random secret, at least 32 characters. The backend refuses to start without it.
# Generate one with:  openssl rand -base64 48
# On Windows without openssl, just run scripts/dev.ps1: it creates .env with a secure random secret.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=604800

# Frontend
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# AI Service
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
AI_SERVICE_LLM_API_KEY=

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# Container runtime
COMPOSE_PROJECT_NAME=devpulse
